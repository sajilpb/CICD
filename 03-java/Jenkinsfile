pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    stages {

        stage('Build') {
            steps {
                dir('03-java') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('03-java') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('03-java') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive') {
            steps {
                dir('03-java') {
                    archiveArtifacts artifacts: 'target/*.jar',
                                       fingerprint: true
                }
            }
        }
    }

    post {
        success {
            echo 'Build succeeded!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}