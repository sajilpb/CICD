pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    stages {

        stage('Maven Environment') {
    steps {
        sh '''
            echo "USER:"
            whoami

            echo "HOME:"
            echo $HOME

            echo "WORKSPACE:"
            echo $WORKSPACE

            echo "MAVEN:"
            which mvn
            mvn -version

            echo "M2:"
            find /home/jenkins -maxdepth 4 -type d -name ".m2" 2>/dev/null || true

            echo "Maven repository:"
            find /home/jenkins -maxdepth 6 -type d -name "repository" 2>/dev/null || true
        '''
    }
}
        stage('Build') {
    steps {
        dir('03-java') {
            sh '''
                mvn clean compile
                echo "----- Maven cache -----"
                find /home/jenkins -type d -name ".m2" 2>/dev/null || true
                find /home/jenkins -type d -name "repository" 2>/dev/null | head -20
            '''
        }
    }
}
        stage('Build') {
            steps {
                dir('03-java') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('03-java') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('03-java') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive') {
            steps {
                dir('03-java') {
                    archiveArtifacts artifacts: 'target/*.jar',
                                       fingerprint: true
                }
            }
        }
    }

    post {
        success {
            echo 'Build succeeded!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}